,"raw_location_text":[{"encoding":"UTF-8","text":"上海"},{"encoding":"UTF-8","text":"广州"}],"raw_organization_name":{"encoding":"UTF-8","text":"上海虹桥正瀚律师事务所"},"raw_requirement_text":{"encoding":"UTF-8","text":"1.国内外知名院校法学专业2027年应届在校本科生或研究生；\n2.曾有国内外著名律所或企业法律相关岗位实习经历者/通过国家法律职业资格考试（本科生/非法本研究生无需遵循此条）优先；\n3.在校期间成绩优秀，具有极强的法律思维和运用能力；\n4.对法律工作有高度热情，热爱并计划长期致力于复杂争议解决领域发展；\n5.工作细致认真、具有优秀的沟通能力及团队合作精神，抗压能力强；\n6.每周实习至少4天，全勤更佳且能完整实习3个月或以上（如海外归国应届毕业生有特殊情况，可视情况安排）。"},"raw_source_record_id":"post-2790:campus-long-term-intern-2027","raw_title":{"encoding":"UTF-8","text":"长期实习生（2027届校招，留用岗位：培训生）"},"recruitment_batch":{"encoding":"UTF-8","text":"2027届校园招聘"},"recruitment_context":{"announcement":{"evidence_locator":{"kind":"HTML","selector":"h1.entry-title"},"identifier_namespace":"official:zhenghan:news","identity_state":"CONFIRMED","official_identifier":{"encoding":"UTF-8","text":"zhenghan-news-2782"}},"opportunity":{"evidence_locator":{"kind":"HTML","selector":"article#post-2790 .entry-content > h3:contains(\"长期实习生\")"},"identity_state":"PROVISIONAL","source_local_identifier":{"encoding":"UTF-8","text":"post-2790:campus-long-term-intern-2027:opportunity"}},"position":{"evidence_locator":{"kind":"HTML","selector":"article#post-2790 .entry-content > h3:contains(\"长期实习生\")"},"identity_state":"PROVISIONAL","source_local_identifier":{"encoding":"UTF-8","text":"post-2790:campus-long-term-intern-2027"}},"recruitment_batch":{"applicability":"APPLICABLE","identity":{"evidence_locator":{"kind":"HTML","selector":"article#post-2790 .entry-content > h3:contains(\"长期实习生\")"},"identity_state":"PROVISIONAL","source_local_identifier":{"encoding":"UTF-8","text":"2027届校园招聘"}}},"recruitment_plan":{"evidence_locator":{"kind":"HTML","selector":"article#post-2782 .entry-content"},"identity_state":"PROVISIONAL","source_local_identifier":{"encoding":"UTF-8","text":"zhenghan-2027-campus-recruitment"}}},"recruitment_year":{"encoding":"UTF-8","text":"2027"},"semantic_hash":"e3fa86fad4b4d28210b54299fe5208d5397161a40