州"}],"raw_organization_name":{"encoding":"UTF-8","text":"上海虹桥正瀚律师事务所"},"raw_requirement_text":{"encoding":"UTF-8","text":"1.拥有国内外知名院校的法学专业本硕学历；\n2.拥有3-5年律师工作经验，并持有律师执业证；\n3.法律专业基础扎实，有优秀的逻辑思辨能力，过硬的文书写作和表达能力，良好的沟通协作能力；\n4.对于商事争议解决领域有强烈志趣，愿意深耕争议解决律师职业，工作踏实勤勉，细致谨慎，有韧劲和恒心；\n5.具有商事诉讼/仲裁案件出庭并担任主要代理人的经验，具备独立出庭代理能力，有一定的客户服务和市场拓展能力；\n6.认同公司制律所的文化和价值观念。"},"raw_source_record_id":"post-2790:dispute-resolution-lawyer","raw_title":{"encoding":"UTF-8","text":"争议解决律师"},"recruitment_batch":{"encoding":"UTF-8","text":"社会招聘"},"recruitment_context":{"announcement":{"evidence_locator":{"kind":"HTML","selector":"h1.entry-title"},"identifier_namespace":"official:zhenghan:news","identity_state":"CONFIRMED","official_identifier":{"encoding":"UTF-8","text":"zhenghan-news-2782"}},"opportunity":{"evidence_locator":{"kind":"HTML","selector":"article#post-2790 .entry-content > h3:contains(\"争议解决律师\")"},"identity_state":"PROVISIONAL","source_local_identifier":{"encoding":"UTF-8","text":"post-2790:dispute-resolution-lawyer:opportunity"}},"position":{"evidence_locator":{"kind":"HTML","selector":"article#post-2790 .entry-content > h3:contains(\"争议解决律师\")"},"identity_state":"PROVISIONAL","source_local_identifier":{"encoding":"UTF-8","text":"post-2790:dispute-resolution-lawyer"}},"recruitment_batch":{"applicability":"NOT_APPLICABLE"},"recruitment_plan":{"evidence_locator":{"kind":"HTML","selector":"article#post-2782 .entry-content"},"identity_state":"PROVISIONAL","source_local_identifier":{"encoding":"UTF-8","text":"zhenghan-2027-campus-recruitment"}}},"recruitment_year":{"$canonical_value":"undefined"},"semantic_hash":"8fc6fb8d23599bd3321e99fc972a40c00a65a0196ef75f97244e9b061f3a375b","snapshot_content_hash":"76a8a32361e1b5adccce54c9f32593fe79a98b3f2e05656e1323c5aef50bf0e4","snapshot_id":"scheduler-source:2681ccc55f84dff988d3a684622d96b27b241d48b35eaf3e62f0f29224b75b40:snapshot:2","source_definition_id":"source-cn-zhenghan-2027-campus-recruitment","source_record_locator":{"kind":"HTML","path":"post-279