":"UTF-8","text":"上海"},{"encoding":"UTF-8","text":"广州"}],"raw_organization_name":{"encoding":"UTF-8","text":"上海虹桥正瀚律师事务所"},"raw_requirement_text":{"encoding":"UTF-8","text":"1.国内外知名院校法学专业2028届及之后的在校本科生或研究生；\n2.曾有国内外著名律所或企业法律相关岗位实习经历者/通过国家法律职业资格考试（本科生/非法本研究生无需遵循此条）优先；\n3.在校期间专业成绩优秀，具有较强的法律思维和运用能力；\n4.对法律工作有高度热情，热爱并计划长期致力于在律师行业发展；\n5.工作细致认真、具有优秀的沟通能力及团队合作精神，抗压能力较强；\n6.每周实习至少3天，且能完整实习3个月或以上。"},"raw_source_record_id":"post-2790:short-term-intern-2028-plus","raw_title":{"encoding":"UTF-8","text":"短期实习生（2028届及之后，无留用机会）"},"recruitment_batch":{"encoding":"UTF-8","text":"2028届及之后实习招聘"},"recruitment_context":{"announcement":{"evidence_locator":{"kind":"HTML","selector":"h1.entry-title"},"identifier_namespace":"official:zhenghan:news","identity_state":"CONFIRMED","official_identifier":{"encoding":"UTF-8","text":"zhenghan-news-2782"}},"opportunity":{"evidence_locator":{"kind":"HTML","selector":"article#post-2790 .entry-content > h3:contains(\"短期实习生\")"},"identity_state":"PROVISIONAL","source_local_identifier":{"encoding":"UTF-8","text":"post-2790:short-term-intern-2028-plus:opportunity"}},"position":{"evidence_locator":{"kind":"HTML","selector":"article#post-2790 .entry-content > h3:contains(\"短期实习生\")"},"identity_state":"PROVISIONAL","source_local_identifier":{"encoding":"UTF-8","text":"post-2790:short-term-intern-2028-plus"}},"recruitment_batch":{"applicability":"APPLICABLE","identity":{"evidence_locator":{"kind":"HTML","selector":"article#post-2790 .entry-content > h3:contains(\"短期实习生\")"},"identity_state":"PROVISIONAL","source_local_identifier":{"encoding":"UTF-8","text":"2028届及之后实习招聘"}}},"recruitment_plan":{"evidence_locator":{"kind":"HTML","selector":"article#post-2782 .entry-content"},"identity_state":"PROVISIONAL","source_local_identifier":{"encoding":"UTF-8","text":"zhenghan-2027-campus-recruitment"}}},"recruitment_year":{"encoding":"UTF-8","text":"2028"},"semantic_hash":"87939176272ff75a854549d2361a25494cc72c24c593b913b85e173a842b713c","snapshot_content_hash":"76a8a32