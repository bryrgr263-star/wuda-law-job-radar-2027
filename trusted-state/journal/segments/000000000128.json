{"command":{"input":{"endpoint":{"adapter_key":"cn-seu-cbit-2027-university-html","collection_config":{"follow_redirects":false,"max_items":2,"max_pages":1,"retry_limit":0,"timeout_ms":20000},"content_kind":"HTML","coverage_regions":[],"decoded_text_encoding":"UTF-8","enabled":true,"locator":"https://em.seu.edu.cn/2026/0922/c57206a584203/page.htm","name":{"original":{"encoding":"UTF-8","text":"东南大学官方发布的中国银保信2027年度招聘公告"}},"recruitment_endpoint_id":"endpoint-seu-cbit-2027-publication","request_method":"GET","source_definition_id":"source-seu-cbit-2027-university-publication"},"extracted_record":{"adapter_metadata":{"cn-seu-cbit-2027-university-html":{"application_platform_acquired":false,"employer_original_verified":false,"publication_basis":"UNIVERSITY_OFFICIAL_PUBLICATION_REPRINT","publisher_kind":"UNIVERSITY_BOARD","publisher_name":"东南大学","qualification_evidence_status":"NEEDS_REVIEW","source_role":"POSITION_BEARING"}},"announcement_url":"https://em.seu.edu.cn/2026/0922/c57206a584203/page.htm","application_url":{"$canonical_value":"undefined"},"contract_version":"EXTRACTED_RECORD_V2","deadline":{"$canonical_value":"undefined"},"extracted_record_id":"extracted:v2:8d47b175a43d4ac82527d344729983d6cfc0bdad2d4f9b9ffe003d9f678919b5","extraction":{"extracted_at":"2026-10-13T01:06:13.015Z","extractor_name":"SeuCbit2027UniversityPublicationAdapter","extractor_version":"1.0.0","schema_version":"cn-seu-cbit-2027-university-html-extracted-record/2.0.0"},"identity_candidates":[{"confidence":"HIGH","kind":"SOURCE_RECORD_ID","value":"seu-cbit-2027:subsidiary-law:row-2"}],"observed_at":"2026-10-13T01:06:13.015Z","publish_time":{"$canonical_value":"undefined"},"raw_description":{"encoding":"UTF-8","text":"2 | 法学类 | 法务岗 | 法学类专业及相关专业 | 若干 | 北京"},"raw_location_text":[{"encoding":"UTF-8","text":"北京"}],"raw_organization_name":{"encoding":"UTF-8","text":"银保信科技（北京）有限公司"},"raw_requirement_text":{"encoding":"UTF-8","text":"法学类专业及相关专业\n三、招聘条件（一）具有中华人民共和国国籍，热爱祖国。（二）境内外高等院校硕士研究生及以上学历应届毕业生（定向和委培生除外），分子公司对于条件特别优秀者，学历可适当放宽至本科。具体要求如下：1.境内高校毕业生：应在2027年7月前毕业且毕业证、学位证齐全。2.境外高校毕业生：毕业回国时间一般不早于2025年底，并能够在2027年6月底前获得学位证书、取得教育部学历学位认证。（三）理解并认同公司使命、愿景和核心价值观。（四）诚实守信，遵纪守法，品行端正，无不良记录。（五）综合素质较好，具有较强的学习能力、沟通能力和团队合作精神。（六）身体健康，心理素质稳定，工作抗压能力强。（七）专业背景与公司人才需求相匹配。（八）具有一定的文字表达能力，熟练使用办公软件。（九）符合亲属回避有关规定，与所应聘单位领导存在夫妻、直系血亲、三代以内旁系血亲、近姻亲关系的，不得应聘具有直接上下级关系的岗位。"},"raw_source_record_id":"seu-cbit-2027:subsidiary-law:row-2","raw_title":{"encoding":"UTF-8","text":"法务岗"},"recruitment_batch":{"encoding":"UTF-8","text":"中国银行保险信息技术管理有限公司2027年度校园招聘"},"recruitment_context":{"announcement":{"evidence_locator":{"kind":"HTML","selector":"h1.arti_title"},"identity_state":"PROVISIONAL","source_local_identifier":{"encoding":"UTF-8","text":"https://em.seu.edu.cn/2026/0922/c57206a584203/page.htm"}},"opportunity":{"evidence_locator":{"kind":"HTML","path":"seu-cbit-2027:subsidiary-law:row-2","selector":".wp_articlecontent > table tr"},"identity_state":"PROVISIONAL","source_local_identifier":{"encoding":"UTF-8","text":"银保信科技（北京）有限公司|2|法务岗"}},"position":{"evidence_locator":{"kind":"HTML","path":"seu-cbit-2027:subsidiary-law:row-2","selector":".wp_articlecontent > table tr"},"identity_state":"PROVISIONAL","source_local_identifier":{"encoding":"UTF-8","text":"银保信科技（北京）有限公司|2|法务岗"}},"recruitment_batch":{"applicability":"APPLICABLE","identity":{"evidence_locator":{"kind":"HTML","selector":"h1.arti_title"},"identity_state":"PROVISIONAL","source_local_identifier":{"encoding":"UTF-8","text":"中国银行保险信息技术管理有限公司2027年度校园招聘"}}},"recruitment_plan":{"evidence_locator":{"kind":"HTML","selector":"h1.arti_title"},"identity_state":"PROVISIONAL","source_local_identifier":{"encoding":"UTF-8","text":"https://em.seu.edu.cn/2026/0922/c57206a584203/page.htm"}}},"recruitment_year":{"encoding":"UTF-8","text":"2027"},"semantic_hash":"b56fb9a273e38f66a7f22d30d5902bb6237bfeab61c1d68377918dbfaa00ae9b","snapshot_content_hash":"074146669e9a979c484414ecaad08a05b608fa720aa71945b82e68c8d0440d6f","snapshot_id":"university-publication:seu-cbit:202