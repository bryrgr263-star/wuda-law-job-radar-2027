{"adapter_metadata":{"cn-zhenghan-2027-official-html":{"approved_announcement_url":"https://www.zhenghan.com/news/2782.html","approved_detail_url":"https://www.zhenghan.com/news/2790.html","source_record_id":"post-2790:campus-long-term-intern-2027","source_role":"POSITION_BEARING"}},"announcement_url":"https://www.zhenghan.com/news/2790.html","application_url":{"$canonical_value":"undefined"},"contract_version":"EXTRACTED_RECORD_V2","deadline":{"$canonical_value":"undefined"},"extracted_record_id":"extracted:v2:1ab116b6a25d3a5f5a6779737104cfa6d55711f2dc28039a80e7e8afb3bfe028","extraction":{"extracted_at":"2026-10-02T08:39:12.805Z","extractor_name":"Zhenghan2027OfficialHtmlAdapter","extractor_version":"1.0.0","schema_version":"cn-zhenghan-2027-official-html-extracted-record/2.0.0"},"identity_candidates":[{"confidence":"HIGH","kind":"SOURCE_RECORD_ID","value":"post-2790:campus-long-term-intern-2027"},{"confidence":"HIGH","kind":"ANNOUNCEMENT_URL","value":"https://www.zhenghan.com/news/2790.html"}],"observed_at":"2026-10-02T08:39:12.805Z","publish_time":{"encoding":"UTF-8","text":"2026-05-13"},"raw_description":{"encoding":"UTF-8","text":"校招岗位；有留用机会；留用岗位为培训生。\n（有留用机会、2027年应届毕业生）\n工作地点：上海、广州（两地择一）\n留用岗位：培训生\n实习要求："},"raw_location_text":[{"encoding":"UTF-8","text":"上海"},{"encoding":"UTF-8","text":"广州"}],"raw_organization_name":{"encoding":"UTF-8","text":"上海虹桥正瀚律师事务所"},"raw_requirement_text":{"encoding":"UTF-8","text":"1.国内外知名院校法学专业2027年应届在校本科生或研究生；\n2.曾有国内外著名律所或企业法律相关岗位实习经历者/通过国家法律职业资格考试（本科生/非法本研究生无需遵循此条）优先；\n3.在校期间成绩优秀，具有极强的法律思维和运用能力；\n4.对法律工作有高度热情，热爱并计划长期致力于复杂争议解决领域发展；\n5.工作细致认真、具有优秀的沟通能力及团队合作精神，抗压能力强；\n6.每周实习至少4天，全勤更佳且能完整实习3个月或以上（如海外归国应届毕业生有特殊情况，可视情况安排）。"},"raw_source_record_id":"post-2790:campus-long-term-intern-2027","raw_title":{"encoding":"UTF-8","text":"长期实习生（2027届校招，留用岗位：培训生）"},"recruitment_batch":{"encoding":"UTF-8","text":"2027届校园招聘"},"recruitment_context":{"announcement":{"evidence_locator":{"kind":"HTML","selector":"h1.entry-title"},"identifier_namespace":"official:zhenghan:news","identity_state":"CONFIRMED","official_identifier":{"encoding":"UTF-8","text":"zhenghan-news-2782"}},"opportunity":{"evidence_locator":{"kind":"HTML","selector":"article#post-2790 .entry-content > h3:contains(\"长期实习生\")"},"identity_state":"PROVISIONAL","source_local_identifier":{"encoding":"UTF-8","text":"post-2790:campus-long-term-intern-2027:opportunity"}},"position":{"evidence_locator":{"kind":"HTML","selector":"article#post-2790 .entry-content > h3:contains(\"长期实习生\")"},"identity_state":"PROVISIONAL","source_local_identifier":{"encoding":"UTF-8","text":"post-2790:campus-long-term-intern-2027"}},"recruitment_batch":{"applicability":"APPLICABLE","identity":{"evidence_locator":{"kind":"HTML","selector":"article#post-2790 .entry-content > h3:contains(\"长期实习生\")"},"identity_state":"PROVISIONAL","source_local_identifier":{"encoding":"UTF-8","text":"2027届校园招聘"}}},"recruitment_plan":{"evidence_locator":{"kind":"HTML","selector":"article#post-2782 .entry-content"},"identity_state":"PROVISIONAL","source_local_identifier":{"encoding":"UTF-8","text":"zhenghan-2027-campus-recruitment"}}},"recruitment_year":{"encoding":"UTF-8","text":"2027"},"semantic_hash":"e3fa86fad4b4d28210b54299fe5208d5397161a4098910eb83adb78318c9346d","snapshot_content_hash":"5a55333e437d182629ac1cdd9d648171d98e657438772fbacc30853125f8a0c4","snapshot_id":"scheduler-source:ff86f87bbfcd8e90fef775cb6ec4dd5b9fd2251d8a2e5e78280adb35dfae5e9f:snapshot:2","source_definition_id":"source-cn-zhenghan-2027-campus-recruitment","source_record_locator":{"kind":"HTML","path":"post-2790:campus-long-term-intern-2027","selector":"article#post-2790 .entry-content > h3:contains(\"长期实习生\")"}}