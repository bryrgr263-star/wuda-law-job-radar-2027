        function getCity(ename){
        	var province=$("select[name="+ename+1+"]").val();
        	console.log(province);
        	$("select[name="+ename+"]").html('<option value="">请选择县市区</option>');
        	if(province&&province!=""){
        		jQuery.ajax({
        	        url : '/resume/getCity',
        	        type : 'post',
        	        data : { "propId" : province.substr(0,2)+"____" },
        	        dataType : 'json',
        	        success : function (opts) {
        	            if (opts && opts.length > 0) {
                            var html = [];
                            html.push('<option value="">请选择市（州）</option>');
                            for (var i = 0; i < opts.length; i++) {
                            	/* if(opts[i].propId.substr(2,2)!="00"){
                                	html.push('<option value="'+opts[i].propId+'">'+opts[i].propName+'</option>');
                                } */
                            	html.push('<option value="'+opts[i].propId+'">'+opts[i].propName+'</option>');
                            }
                            $("select[name="+ename+2+"]").html('');
                            $("select[name="+ename+2+"]").append(html.join(''));
                        }
        	    	}
                });
        	}else{
        	 	$("select[name="+ename+2+"]").html('<option value="">请选择市（州）</option>');
        	}

        }
