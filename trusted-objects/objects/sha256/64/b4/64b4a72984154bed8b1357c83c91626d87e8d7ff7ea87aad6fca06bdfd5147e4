		function closeAccount() {
			$("#mask").css('display','block');
			document.body.style.overflow = 'hidden';
			var dd = dialog({
				title: '提示',
				content:'账户一旦注销将无法恢复，是否注销账户？',
				width: 400,
				top:100,
				zIndex: 3000,
				cancelValue: '取消',
				cancel: function () {
					$("#mask").css('display','none');
					document.body.style.overflow = 'auto';
					return;
				},
				okValue: '确定',
				ok: function () {
					var ing = dialog({
						title: "正在注销,请稍后...",
						width:420,
						zIndex: 3000,
					}).show();
					dd.close();
					$.post("/closeAccount", function (data) {
						ing.close();
						data = JSON.parse(data);
						if(data.code == 304){
							closeAccount304(data);
						}else {
							dialog({
								title: '提示',
								content: data.msg,
								okValue: '确定',
								width: 420,
								zIndex: 3000,
								ok: function () {
									$("#mask").css('display', 'none');
									document.body.style.overflow = 'auto';
									if (data.code == 200) {
										window.location.href = "/loginout";
									}
									return true;
								}
							}).show();
						}
					}).error(function(){
						ing.close();
						dialog({
							title: '提示',
							content: '账户注销异常',
							okValue: '确定',
							width: 420,
							zIndex: 3000,
							ok: function () {
								$("#mask").css('display','none');
								document.body.style.overflow = 'auto';
								return true;
							}
						}).show();
					});
				}
			}).show();
		}
		function closeAccount304(data){
			$("#mask").css('display','block');
			document.body.style.overflow = 'hidden';
			var okValue = '确定';
			var cancelValue = '取消';
			if(data.type == 4){
				okValue = '注销入职';
				cancelValue = '注销不入职';
			}
			var dd = dialog({
				title: '提示',
				content: data.msg,
				width: 400,
				top:100,
				zIndex: 3000,
				cancelValue: cancelValue,
				cancel: function () {
					dd.close();
					if(data.type == 4){
						entryCancellation(0);
					}
				},
				okValue: okValue,
				ok: function () {
					dd.close();
					if(data.type == 4){
						entryCancellation(1);
					}
				}
			}).show();
		}
		//注销入职(0:不入职；1:入职)
		function entryCancellation(type){
			$("#mask").css('display','block');
			document.body.style.overflow = 'hidden';
			var ing = dialog({
				title: "正在注销,请稍后...",
				width:420,
				zIndex: 3000,
			}).show();
			var url = type==0?"/unEntryCancellation":"/entryCancellation";
			$.post(url, function (data) {
				ing.close();
				data = JSON.parse(data);
				dialog({
					title: '提示',
					content: data.msg,
					okValue: '确定',
					width: 420,
					zIndex: 3000,
					ok: function () {
						$("#mask").css('display','none');
						document.body.style.overflow = 'auto';
						if (data.code == 200 ) {
							window.location.href = "/loginout";
						}
						return true;
					}
				}).show();
			}).error(function(){
				ing.close();
				dialog({
					title: '提示',
					content: '账户注销异常',
					okValue: '确定',
					width: 420,
					zIndex: 3000,
					ok: function () {
						$("#mask").css('display','none');
						document.body.style.overflow = 'auto';
						return true;
					}
				}).show();
			})
		}
