    	var loginSmsCountdown = 60;
    	function setLoginSmsTime(val) {
            if (loginSmsCountdown == 0) {
                val.removeAttribute("disabled");
                val.innerHTML = "发送动态码";
                loginSmsCountdown = 60;
                return;
            } else {
                val.setAttribute("disabled", true);
                val.innerHTML = "重新发送(" + loginSmsCountdown + ")";
                loginSmsCountdown--;
            }
            setTimeout(function() {
                setLoginSmsTime(val)
            }, 1000)
        }
    	function sendLoginSms(val) {
            var pidNo = $.trim($("#pid").val());
            if (pidNo == "") {
                dialog({
                    title: '提示',
                    content: '请先填写证件号码！',
                    zIndex: 2000,
                    width: 420,
                    okValue: '确定',
                    ok: function() {
                        return true;
                    }
                }).show();
                return;
            }
            var yzm1 = $.trim($("#yzm1").val());
            if (yzm1 == "") {
                dialog({
                    title: '提示',
                    content: '请先填写图形验证码！',
                    zIndex: 2000,
                    width: 420,
                    okValue: '确定',
                    ok: function() {
                        return true;
                    }
                }).show();
                return;
            }
            $.ajax({
                type: "POST",
                url: "/loginMobileVerCode?rdmnum=" + Math.random(),
                data: {
                    pid: pidNo,
                    pidtype: $("#pidtype").val(),
                    yzm1: yzm1
                },
                dataType: "json",
                success: function(result) {
                    if (result.success) {
                        setLoginSmsTime(val);
                        dialog({
                            title: '提示',
                            content: result.msg,
                            zIndex: 2000,
                            width: 420,
                            okValue: '确定',
                            ok: function() {
                                return true;
                            }
                        }).show();
                    } else {
                        dialog({
                            title: '提示',
                            content: result.msg,
                            zIndex: 2000,
                            width: 420,
                            okValue: '确定',
                            ok: function() {
                                refreshCaptcha(1);
                                $("#yzm1").val("");
                                return true;
