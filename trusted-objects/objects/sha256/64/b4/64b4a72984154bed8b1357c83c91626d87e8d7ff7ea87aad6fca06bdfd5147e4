    	function  getByteLen(eventBox,val,textLength){
    		if (val == null) {
    			return 0;
    		} else {
    			var result = '';
    			chrlen = val.replace(/[^\x00-\xff]/g, 'xx').length;
    			strlen = val.length;// 字符串长度
    			if(chrlen >textLength){
    				for(var i=0,j=0;i<strlen;i++){
    		            var chr = val.charAt(i);
    		            if(/[\x00-\xff]/.test(chr)){
    		                j++; // ascii码为0-255，一个字符就是一个字节的长度
    		            }else{
    		                j+=2; // ascii码为0-255以外，一个字符就是两个字节的长度
    		            }
    		            if(j<=textLength){ // 当加上当前字符以后，如果总字节长度小于等于L，则将当前字符真实的+在result后
    		                result += chr;
    		            }else{ // 反之则说明result已经是不拆分字符的情况下最接近L的值了，直接返回
    		            	 $(eventBox).val(result);
    		            	if(/[\x00-\xff]/.test(chr)){
    		            	    return j-1;
	    		            }else{
	    		            	return j-2;
	    		            }

    		            }
    		        }
    			}else{
    				return chrlen;
    			}
    		}
    	}
