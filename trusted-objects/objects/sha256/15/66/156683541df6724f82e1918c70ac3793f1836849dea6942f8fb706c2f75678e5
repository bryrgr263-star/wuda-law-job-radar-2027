<script>
    $(function () {
        // 点击立即登录
        $(".module_right_for_ai_icon.nologin .module_right_ai_icon_login_btn").click(function () {
            location.href = "/client/login/index/redirect_url/%252Fclient%252Fcampus%252Fcustomizedptjobdetail%252Fsid%252F64%252Frid%252F61.html";
        });
        // 点击关闭登录弹窗
        $(".module_right_for_ai_icon.nologin .module_right_ai_icon_nologin_close").click(function () {
            $(".module_right_for_ai_icon").removeClass("cb-hide");
            $(".module_right_for_ai_icon.nologin").addClass("cb-hide");
        });
        // 点击智能助手图标，展开智能助手对话框
        $(".module_right_for_ai_icon:not(.nologin)").click(function () {
            if (!clientAiChatRightContentVm.userId) {
                $(this).addClass("cb-hide");
                // 如果用户未登录，则弹出登录弹窗
                $(".module_right_for_ai_icon.nologin").removeClass("cb-hide");
                return false;
            }
            $(".module_right_for_ai_icon").addClass("cb-hide");
            $("body").css("width", "calc(100% - 400px)");
            $(".header-client-new.fixed-top").css("width", "calc(100% - 400px)");
            $(".header-client-new.fixed-top .headerbox").css("width", "100%");
            $(".client_ai_chat_right_box").removeClass("cb-hide");
            clientAiChatRightContentVm.userInput = "";
            clientAiChatRightContentVm.userInputFileObj = null;
            $("textarea[name='user_input']").focus();
            clientAiChatRightContentVm.getHistoryList();
            // 检查滚动状态
            setTimeout(function() {
                var chatListDom = $(".client_ai_chat_right_list");
                var scrollTop = chatListDom.scrollTop();
                var scrollHeight = chatListDom[0].scrollHeight;
                var clientHeight = chatListDom.height();
                var isAtBottom = scrollTop + clientHeight >= scrollHeight - 1;
                clientAiChatRightContentVm.showScrollToBottomBtn = !isAtBottom;
            }, 100);
        });
        // 点击收起按钮，收起智能助手对话框
