                    });
                },
                // 处理返回的数据
                handleResponseData: function (res) {
                    var appThis = this;
                    var resData = JSON.parse(res.data);
                    if (resData && resData.type == "stream" && resData.content) {
                        // 第一次收到消息，则隐藏loading
                        if (appThis.lastConversationContent == "") {
                            appThis.hideLoading();
                        }
                        // 收到ai的回复后，逐步显示给用户
                        appThis.lastConversationContent += resData.content;
                        // 判断最后一句是ai的还是用户的，如果是ai的，则对最后一句的content进行替换
                        if (appThis.chatDataList[appThis.chatDataList.length - 1].role == "ai") {
                            appThis.chatDataList[appThis.chatDataList.length - 1].content.content = appThis.lastConversationContent;
                        } else {
                            appThis.chatDataList.push({
                                role: "ai",
                                content: {
                                    type: "text",
                                    content: appThis.lastConversationContent
                                },
                                actions: "",
                                like_type: 0
                            });
                        }
                        appThis.scrollToBottom(0);
                    } else if (resData && resData.type == "stream_end") {
                    } else if (resData && resData.type == "final") {
                        if (resData.content.reason) {
                            appThis.chatDataList.push({
                                role: "ai",
                                content: {
                                    type: "text",
                                    content: resData.content.reason
                                },
                                actions: "",
                                like_type: 0
                            });
                            appThis.saveChatMsg({
                                role: "ai",
                                content: JSON.stringify({
                                    type: "text",
                                    content: resData.content.reason
                                }),
                                actions: ""
                            });
                        } else if (resData.content.type == "industry_list") {
                            // 产业列表
                            appThis.chatDataList.push({
                                role: "ai",
                                content: {
                                    type: "industry_list",
                                    content: resData.content
                                },
                                actions: "",
                                like_type: 0
                            });
                            appThis.saveChatMsg({
                                role: "ai",
                                content: JSON.stringify({
                                    type: "industry_list",
                                    content: resData.content
                                }),
                                actions: ""
                            });
                        } else if (resData.content.type == "industry_intro") {
                            // 产业介绍
                            appThis.chatDataList.push({
                                role: "ai",
                                content: {
                                    type: "industry_intro",
                                    content: resData.content
                                },
                                actions: "",
                                like_type: 0
                            });
                            appThis.saveChatMsg({
                                role: "ai",
                                content: JSON.stringify({
                                    type: "industry_intro",
                                    content: resData.content
                                }),
                                actions: ""
                            });
                        } else {
                            appThis.chatDataList.push({
                                role: "ai",
                                content: {
                                    type: "job_recommend",
                                    content: resData.content
                                },
                                actions: "",
                                like_type: 0
                            });
                            appThis.saveChatMsg({
                                role: "ai",
                                content: JSON.stringify({
                                    type: "job_recommend",
                                    content: resData.content
                                }),
                                actions: ""
                            });
                        }
                        appThis.resetChatState();
                        appThis.scrollToBottom(0);
                    } else if (resData && resData.type == "error") {
                        console.log(resData.error, "resData.error");
                        appThis.chatDataList.push({
                            role: "ai",
                            content: {
                                type: "text",
                                content: resData.error
                            },
                            actions: "",
                            like_type: 0
                        });
                        appThis.saveChatMsg({
                            role: "ai",
                            content: JSON.stringify({
                                type: "text",
                                content: resData.error
                            }),
                            actions: ""
                        });
                        appThis.resetChatState();
                        appThis.scrollToBottom(0);
                    }
                },
                // 用户停止输出
                userClickStop: function () {
                    var appThis = this;
                    appThis.userStop = true;
                    appThis.resetChatState();
                    // 使用 AbortController 停止连接
                    if (appThis.abortController) {
                        appThis.abortController.abort();
                    }
                },
                // 滚动到底部（带防抖）
                scrollToBottom: function (height) {
                    var appThis = this;
                    // 清除之前的定时器
                    if (appThis.scrollTimer) {
                        clearTimeout(appThis.scrollTimer);
                    }
                    // 设置新的定时器，防抖处理
                    appThis.scrollTimer = setTimeout(function () {
                        var chatListDom = $(".client_ai_chat_right_list");
                        var scrollHeight = chatListDom[0].scrollHeight;
                        var containerHeight = chatListDom.height();
                        chatListDom.animate({
                            scrollTop: scrollHeight - containerHeight + height
                        }, 200, function() {
                            // 滚动完成后检查是否需要显示按钮
                            var scrollTop = chatListDom.scrollTop();
                            var currentScrollHeight = chatListDom[0].scrollHeight;
                            var currentClientHeight = chatListDom.height();
                            var isAtBottom = scrollTop + currentClientHeight >= currentScrollHeight - 1;
                            appThis.showScrollToBottomBtn = !isAtBottom;
                        });
                    }, 200);
                },
