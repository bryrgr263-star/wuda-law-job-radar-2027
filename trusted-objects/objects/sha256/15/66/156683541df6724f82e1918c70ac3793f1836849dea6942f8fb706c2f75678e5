                    cb_ajax("/ajax/aiassistor/likemessage", { message_id: item.id, like_type: item.like_type == 1 ? 0 : 1 }, function (res) {
                        if (res.status == 1) {
                            if (item.like_type == 1) {
                                appThis.chatDataList[index].like_type = 0;
                            } else {
                                appThis.chatDataList[index].like_type = 1;
                            }
                        } else {
                            layer.msg("操作失败，请稍后再试！", function () { });
                            return false;
                        }
                    }, { hasBlock: 0 });
                },
                // 点踩/取消踩
                chatBad: function (index, item) {
                    var appThis = this;
                    cb_ajax("/ajax/aiassistor/likemessage", { message_id: item.id, like_type: item.like_type == 2 ? 0 : 2 }, function (res) {
                        if (res.status == 1) {
                            if (item.like_type == 2) {
                                appThis.chatDataList[index].like_type = 0;
                            } else {
                                appThis.chatDataList[index].like_type = 2;
                            }
                        } else {
                            layer.msg("操作失败，请稍后再试！", function () { });
                            return false;
                        }
                    }, { hasBlock: 0 });
                },
                // 通过后端接口保存聊天消息
                saveChatMsg: function (data) {
                    var appThis = this;
                    var postData = {
                        conversation_id: this.conversationId,
                        assistant_type: "wenda",
                        role: data.role,
                        content: data.content,
                        actions: data.actions ?? ""
                    };
                    cb_ajax("/ajax/aiassistor/savemessage", postData, function (res) {
                        if (res.status == 1) {
                            // 保存成功后，将chatDataList里id为空的，role跟postData的role相同的记录的id设置为res.data.id
                            if (res.data.message_id) {
                                appThis.chatDataList.forEach(function (item) {
                                    if (!item.id && item.role == postData.role) {
                                        item.id = res.data.message_id;
                                    }
                                });
                            }
                        }
                    }, { hasLoad: 0, hasBlock: 0 });
                },
                // 文件上传
                handleFileUploadClick: function () {
                    this.$refs.fileInput.click();
                },
                // 文件选择
                handleFileChange: function (event) {
                    var appThis = this;
                    var file = event.target.files[0];
                    if (!file) return;

                    // 检查文件类型
                    var fileExtension = file.name.split(".").pop().toLowerCase();
                    var allowedExtensions = ["pdf", "doc", "docx", "jpg", "jpeg", "png"];

                    if (!allowedExtensions.includes(fileExtension)) {
                        layer.msg("请上传正确的文件格式，目前支持pdf、doc、docx、jpg、jpeg、png格式");
                        this.$refs.fileInput.value = ""; // 清空文件选择
                        return false;
                    }

                    // 检查文件大小（10MB）
                    if (file.size > 10 * 1024 * 1024) {
                        layer.msg("文件大小不能超过10MB");
                        this.$refs.fileInput.value = "";
                        return false;
                    }

                    // 创建 FormData
                    var formData = new FormData();
                    formData.append("file", file);

                    // 显示加载中
                    var load2 = layui.layer.load(2);

                    // 发送上传请求
                    $.ajax({
                        url: "/ajax/upload/cloudupload.html",
                        type: "POST",
                        data: formData,
                        processData: false,
                        contentType: false,
                        success: function (res) {
                            if (res.status == 1) {
                                // layer.msg("上传成功");
                                appThis.userInputFileObj = res.data;
                                appThis.scrollToBottom(0);
                            } else {
                                // 显示错误信息
                                layer.msg(res.msg || "上传失败");
                            }
                        },
                        error: function (xhr, status, error) {
                            layer.msg("上传失败，请稍后重试");
                        },
                        complete: function () {
                            // 清理工作
                            layui.layer.close(load2);
                            appThis.$refs.fileInput.value = ""; // 清空文件选择，允许重新选择同一文件
                        }
                    });
                },
                // 添加图片预览方法
                showImagePreview: function(imgSrc) {
                    // 创建一个临时图片对象来获取图片的原始尺寸
                    var img = new Image();
                    img.src = imgSrc;
                    
                    img.onload = function() {
                        var imgWidth = img.width;
                        var imgHeight = img.height;
                        
                        // 获取屏幕尺寸
                        var screenWidth = window.innerWidth;
                        var screenHeight = window.innerHeight;
                        
                        // 计算图片在屏幕上的最大显示尺寸
                        var maxWidth = screenWidth * 0.9; // 最大宽度为屏幕宽度的90%
                        var maxHeight = screenHeight * 0.9; // 最大高度为屏幕高度的90%
                        
                        // 计算缩放比例
                        var scale = Math.min(
                            maxWidth / imgWidth,
                            maxHeight / imgHeight,
                            1 // 如果图片本身就比最大尺寸小，则不放大
                        );
                        
                        // 计算最终显示尺寸
                        var displayWidth = Math.round(imgWidth * scale);
                        var displayHeight = Math.round(imgHeight * scale);
                        
                        // 使用layer弹窗显示图片
                        layer.open({
                            type: 1,
                            title: false,
                            closeBtn: 1,
                            area: [displayWidth + 'px', displayHeight + 'px'], // 设置弹窗尺寸
                            skin: 'layui-layer-nobg', // 没有背景色
                            shadeClose: true,
                            content: '<div class="image-preview-container" style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;">' +
                                    '<img src="' + imgSrc + '" style="max-width:100%;max-height:100%;object-fit:contain;">' +
                                    '</div>',
                        });
                    };
                }
            }
        });
    });
</script>
