                // 对话聊天
                chatQuery: function (jsonObj) {
                    var appThis = this;
                    // 创建 AbortController 来控制连接
                    appThis.abortController = new AbortController();
                    FetchEventSource.fetchEventSource(appThis.baseApiUrl + "/ajax/aiassistor/sendmessage", {
                        method: "POST",
                        // 添加此配置，使连接在页面隐藏（浏览器tab页切换）时保持打开，否则切换tab页面时，连接会断开，再切换回来时会再次创建连接
                        openWhenHidden: true,
                        headers: {},
                        signal: appThis.abortController.signal,
                        body: JSON.stringify({
                            message: jsonObj.content,
                            assistant_type: "wenda",
                            tool: appThis.tool ?? "",
                            files: jsonObj.files ?? []
                        }),
                        onmessage(res) {
                            // console.log(res, "res");
                            if (!appThis.userStop) {
                                appThis.handleResponseData(res);
                            }
                        },
                        onerror(err) {
                            console.error("错误：", err);
                            layer.msg("连接失败，请稍后再试！", function () { });
                            appThis.resetChatState();
                            // 抛出异常来阻止自动重试
                            throw err;
                        },
                        onclose() {
                            console.log("连接关闭");
                            if (appThis.lastConversationContent) {
                                appThis.scrollToBottom(0);
                                appThis.saveChatMsg({
                                    role: "ai",
                                    content: JSON.stringify({
                                        type: "text",
                                        content: appThis.lastConversationContent
